<IfModule mod_rewrite.c>
    RewriteEngine On

    # Clean URL routing — kompatibel untuk:
    #   - local:  http://localhost/sitaji/...  (prefix /sitaji)
    #   - local:  http://sitaji/...            (vhost, prefix /)
    #   - produksi: https://sitaji.kemenagkabpasuruan.id/...  (prefix /)
    #
    # Redirect .php -> clean URL HANYA untuk GET/HEAD.
    # POST/PUT/DELETE (AJAX & form) tidak boleh di-redirect: 301 mengubah
    # method menjadi GET dan menghapus request body.
    RewriteCond %{REQUEST_METHOD} !^(POST|PUT|DELETE)$ [NC]
    RewriteCond %{THE_REQUEST} \s(/.+?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,QSA]

    # Internal map clean URL -> .php (relatif ke direktori .htaccess, prefix-agnostic)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [L]
</IfModule>
