# .env.example — Template konfigurasi database
# Salin file ini menjadi .env dan isi sesuai environment Anda.
# File .env TIDAK di-commit ke git (ada di .gitignore).

# Environment: 'local' untuk Laragon, 'production' untuk VPS aaPanel
APP_ENV=local

# Database configuration
DB_HOST=localhost
DB_NAME=sitaji
DB_USER=root
DB_PASS=
